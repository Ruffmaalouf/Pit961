# Base URL of the PIT961 backend API.
# Client-visible by design (VITE_* is inlined into the bundle) — this is only a URL, never a secret.
# NEVER put a server-side secret behind a VITE_ prefix.
VITE_API_BASE_URL=http://localhost:5289

# Consumed by playwright.config.ts only (not by the app bundle).
# PLAYWRIGHT_BASE_URL=http://localhost:5173
