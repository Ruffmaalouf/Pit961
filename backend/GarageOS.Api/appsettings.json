{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Demo": {
    "Message": "PIT961 backend scaffold is alive (WP-2)."
  },
  "ConnectionStrings": {
    "_comment": "No real connection strings/credentials are committed. Local dev overrides via dotnet user-secrets or a gitignored appsettings.Local.json; production via environment variables / host secret store. See README.md.",
    "GarageOsDb": "",
    "PlatformDb": ""
  }
}
